{
  "name": "user-login-node-api-kiro",
  "version": "1.0.0",
  "description": "User Login API with Node.js, Express, SQLite and Scalar documentation",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.4.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "sql.js": "^1.12.0",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "nodemon": "^3.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "moduleNameMapper": {
      "@scalar/express-api-reference": "<rootDir>/tests/__mocks__/@scalar/express-api-reference.js"
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/docs/**"
    ]
  }
}
